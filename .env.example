# Copy to .env and fill in. Never commit .env.
# Anthropic Messages API (any compatible endpoint)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
# claude (default) | offline = rule-based parser, no AI, no key needed
AGENT_MODE=claude

# PayPal: "mock" (default, no network) or "sandbox"
PAYPAL_MODE=mock
# mock only: 1 = orders wait for a (local, simulated) PayPal buyer approval like the real Sandbox
PAYPAL_MOCK_APPROVAL=0
# sandbox auth: "oauth" (client id + secret below) or "proxy" (credentials injected by an egress proxy)
PAYPAL_AUTH=oauth
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# where PayPal sends the buyer back after approve/cancel
PUBLIC_BASE_URL=http://localhost:8000
# minutes an unapproved PayPal order keeps its budget reservation
PAYPAL_APPROVAL_TTL_MIN=180

# token required by POST /approvals/{id}/approve|reject (empty = open, dev only)
APPROVER_TOKEN=

# Optional paths
POLICY_PATH=policy.yaml
CATALOG_PATH=data/catalog.json
DB_PATH=guardrail.db
